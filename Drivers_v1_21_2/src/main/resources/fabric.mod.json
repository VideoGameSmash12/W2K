{
  "schemaVersion": 1,
  "id": "w2k-drivers-v1_21_2",
  "version": "${version}",
  "name": "Trickier Drivers",
  "description": "Minecraft 1.21.2 to 1.21.3 drivers for W2K",
  "authors": [
    "videogamesm12"
  ],
  "contact": {
    "repo": "https://github.com/videogamesm12/W2K"
  },
  "license": "MIT",
  "icon": "assets/w2k-drivers-v1_21_2/icon.png",
  "environment": "client",
  "entrypoints": {
    "w2k-event-passthru-driver": [
      "me.videogamesm12.w2k.drivers.v1_21_2.required.W1212EventPassthruDriver"
    ],
    "w2k-version-bridge-driver": [
      "me.videogamesm12.w2k.drivers.v1_21_2.required.W1212VersionBridgeDriver"
    ],
    "w2k-command-wrapper-driver": [
      "me.videogamesm12.w2k.drivers.v1_21_2.required.W1212CommandDriver"
    ]
  },
  "mixins": [
    "w2k.drivers.1_21_2.mixins.json"
