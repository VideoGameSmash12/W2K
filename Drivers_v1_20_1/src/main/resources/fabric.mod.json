{
  "schemaVersion": 1,
  "id": "w2k-drivers-v1_20_1",
  "version": "${version}",
  "name": "Trails & Drivers",
  "description": "Minecraft 1.20 - 1.20.1 drivers for W2K",
  "authors": [
    "videogamesm12"
  ],
  "contact": {
    "repo": "https://github.com/videogamesm12/W2K"
  },
  "license": "MIT",
  "icon": "assets/w2k-drivers-v1_20_1/icon.png",
  "environment": "client",
  "entrypoints": {
    "w2k-event-passthru-driver": [
      "me.videogamesm12.w2k.drivers.v1_20_1.required.W120EventPassthruDriver"
