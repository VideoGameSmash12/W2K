{
  "schemaVersion": 1,
  "id": "w2k-drivers-v1_21",
  "version": "${version}",
  "name": "Tricky Drivers",
  "description": "Minecraft 1.21 drivers for W2K",
  "authors": [
    "videogamesm12"
  ],
  "contact": {
    "repo": "https://github.com/videogamesm12/W2K"
  },
  "license": "MIT",
  "icon": "assets/w2k-drivers-v1_21/icon.png",
  "environment": "client",
  "entrypoints": {
    "w2k-event-passthru-driver": [
      "me.videogamesm12.w2k.drivers.v1_21.required.W121EventPassthruDriver"
    ],
    "w2k-version-bridge-driver": [
      "me.videogamesm12.w2k.drivers.v1_21.required.W121VersionBridgeDriver"
    ],
    "w2k-command-wrapper-driver": [
      "me.videogamesm12.w2k.drivers.v1_21.required.W121CommandDriver"
    ]
  },
  "mixins": [
    "w2k.drivers.1_21.mixins.json"
  ],
  "depends": {
    "minecraft": ["1.21", "1.21.1"]
  },
  "custom": {
    "modmenu": {
      "badges": ["library"],
      "parent": "w2k"
    }
  }
}
